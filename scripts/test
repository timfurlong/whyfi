#!/usr/bin/env bash
# Runs the unit tests and prints a short summary. Extra arguments go to xcodebuild.
# Run the tests that need this Mac's Wi-Fi and speech recognition too with
#   TEST_RUNNER_WHYFI_HARDWARE_TESTS=1 scripts/test
set -uo pipefail
cd "$(dirname "$0")/.."
log=$(mktemp -t whyfi-test)
xcodebuild test -project WhyFi.xcodeproj -scheme WhyFi -destination 'platform=macOS' "$@" >"$log" 2>&1
status=$?
echo "full log: $log"
grep -E '(error|warning): |✘|recorded an issue|Failing tests:' "$log" | grep -v -E 'appintentsmetadataprocessor|linkd' | sort -u
grep -A20 '^Failing tests:' "$log" | sed -n '2,/^$/p' | sed '/^$/d'
grep -E 'Test run with' "$log"
grep -E '\*\* (TEST|BUILD) [A-Z]+ \*\*' "$log" | tail -1
exit $status

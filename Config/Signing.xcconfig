// Code signing for WhyFi.
//
// By default the app is signed "to run locally", which needs no Apple account. The catch:
// macOS treats every rebuild as a new app and asks for the microphone and Location again.
// To sign with your own Apple Development certificate instead, copy
// Signing.local.xcconfig.example to Signing.local.xcconfig (it's gitignored) and set your
// team ID. macOS then remembers the permissions across rebuilds.
CODE_SIGN_STYLE = Manual
CODE_SIGN_IDENTITY = -
DEVELOPMENT_TEAM =

#include? "Signing.local.xcconfig"
